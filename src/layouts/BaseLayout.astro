---
import { ViewTransitions } from 'astro:transitions'
import BaseHead from '@/components/BaseHead.astro'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.vue'
import '../styles/global.css'
import 'katex/dist/katex.min.css'

const { ...head } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <BaseHead {...head} />
    <ViewTransitions />

    <script is:inline>
      // 1. Sets initial color IMMEDIATELY to prevent FOUC (Flash of Unstyled Content)
      (function () {
        const saved = localStorage.getItem('vueuse-color-scheme') || 'light'
        const isDark = saved === 'dark'
        const root = document.documentElement

        root.classList.toggle('dark', isDark)
        root.style.colorScheme = isDark ? 'dark' : 'light'
        // DO NOT add 'transition-ready' here, or the initial load will flash!
      })()
    </script>

    <style is:inline>
      html {
        background-color: #fafafa;
        color: #1f2937;
      }
      html.dark {
        background-color: #0f1419;
        color: #d1d5db;
      }
      body {
        margin: 0;
        padding: 0;
      }
    </style>
  </head>

  <body class="bg-main text-main min-h-screen font-sans w-full bg-dot relative">
    <div transition:persist="site-header">
      <Header client:load />
    </div>

    <main class="grow max-w-3xl mx-auto sm:pt-36 pt-26 pb-16 px-6 relative">
      <slot />
      <Footer />
    </main>

    <script is:inline>
if ('scrollRestoration' in history) {
  history.scrollRestoration = 'manual'
}

window.addEventListener('beforeunload', () => {
  sessionStorage.setItem(`scrollPos:${window.location.pathname}`, window.scrollY.toString())
})

window.addEventListener('load', () => {
  const savedPos = sessionStorage.getItem(`scrollPos:${window.location.pathname}`)

  if (savedPos) {
    const images = document.querySelectorAll('img')
    const imagePromises = Array.from(images).map((img) => {
      if (img.complete)
        return Promise.resolve()
      return new Promise((resolve) => {
        img.onload = resolve
        img.onerror = resolve
      })
    })

    Promise.all(imagePromises).then(() => {
      window.scrollTo(0, Number.parseInt(savedPos))
      sessionStorage.removeItem(`scrollPos:${window.location.pathname}`)
    })
  }
  else {
    window.scrollTo(0, 0)
  }
})

document.addEventListener('astro:before-swap', (e) => {
  const saved = localStorage.getItem('vueuse-color-scheme')
  const isDark = saved === 'dark'
  const newDoc = e.newDocument.documentElement

  // Strip the transition class BEFORE swapping so the new page doesn't animate its entry
  newDoc.classList.remove('transition-ready')

  if (isDark) {
    newDoc.classList.add('dark')
    newDoc.style.colorScheme = 'dark'
  }
  else {
    newDoc.classList.remove('dark')
    newDoc.style.colorScheme = 'light'
  }
})

document.addEventListener('astro:page-load', () => {
  const saved = localStorage.getItem('vueuse-color-scheme')
  const isDark = saved === 'dark'
  const root = document.documentElement

  if (isDark) {
    root.classList.add('dark')
  }
  else {
    root.classList.remove('dark')
  }

  // 3. Add the transition class slightly AFTER the page loads so it only animates on user clicks, not page routing
  setTimeout(() => {
    root.classList.add('transition-ready')
  }, 50)
})

if (!window.hasSetupSmoothScroll) {
  document.addEventListener('click', (e) => {
    const anchor = e.target.closest('a[href^="#"]')
    if (!anchor)
      return

    const hash = anchor.getAttribute('href')
    if (hash === '#')
      return

    const target = document.querySelector(hash)
    if (target) {
      e.preventDefault()
      target.scrollIntoView({
        behavior: 'smooth',
        block: 'start',
      })
      history.pushState(null, '', hash)
    }
  })
  window.hasSetupSmoothScroll = true
}
</script>

    <style>
      .transition-ready html,
      .transition-ready body,
      .transition-ready main,
      .transition-ready footer {
        transition: background-color 200ms ease-in-out, border-color 200ms ease-in-out !important;
      }

      /* We separated the header so it is allowed to animate its sliding movement (transform) */
      .transition-ready header {
        transition: background-color 200ms ease-in-out, border-color 200ms ease-in-out, transform 400ms ease !important;
      }

      .transition-ready .prose :where(h1, h2, h3, h4, p, li, blockquote) {
        transition: color 200ms ease-in-out !important;
      }

      .katex,
      .katex *,
      .math,
      .math * {
        transition: none !important;
      }
    </style>
<script>
// This runs on initial load and every time Astro switches pages
document.addEventListener('astro:page-load', () => {
  // 1. Grab every single anchor (link) tag on the page
  const allLinks = document.querySelectorAll('a')

  allLinks.forEach((link) => {
    const href = link.getAttribute('href')

    // 2. Check if it's a valid external link (starts with http:// or https://)
    if (href && (href.startsWith('http://') || href.startsWith('https://'))) {
      try {
        const targetUrl = new URL(href, window.location.href)

        // 3. Check if the link's domain matches your website's domain
        if (targetUrl.hostname !== window.location.hostname) {
          // 4. Force standard HTML behavior for SEO and backup
          link.setAttribute('target', '_blank')
          link.setAttribute('rel', 'noopener noreferrer')

          // 5. Block Astro/NProgress from hijacking the external click
          link.addEventListener('click', (e) => {
            e.preventDefault()
            e.stopPropagation()

            // 6. Launch a pristine browser instance for the destination URL
            window.open(href, '_blank', 'noopener,noreferrer')
          })
        }
      }
      catch (error) {
        // Soft catch just in case an invalid URL string slips through
        console.error('Error processing link:', error)
      }
    }
  })
})
</script>
  </body>
</html>
