---
import BaseHead from '@/components/BaseHead.astro'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.vue'
import 'katex/dist/katex.min.css'

const { ...head } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <script is:inline>
      (function () {
        const saved = localStorage.getItem('vueuse-color-scheme') || 'light'
        const isDark = saved === 'dark'

        const root = document.documentElement

        root.classList.toggle('dark', isDark)
        root.style.colorScheme = isDark ? 'dark' : 'light'

        root.classList.add('transition-ready')
      })()
    </script>

    <style is:inline>
      html {
        background-color: #fafafa;
        color: #1f2937;
      }

      html.dark {
        background-color: #0f1419;
        color: #d1d5db;
      }

      body {
        margin: 0;
        padding: 0;
        visibility: hidden;
      }

      body.loaded {
        visibility: visible;
      }

      html {
        view-transition-name: none !important;
      }

      body {
        view-transition-name: none !important;
      }
    </style>

    <BaseHead {...head} />
  </head>

  <body
    class="bg-main text-main min-h-screen font-sans w-full bg-dot relative"
    style="view-transition-name: none;"
  >
    <Header client:idle />

    <main class="grow max-w-3xl mx-auto sm:pt-36 pt-26 pb-16 px-6 relative">
      <slot />
      <Footer />
    </main>

    <script is:inline>
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual'
      }

      window.addEventListener('beforeunload', () => {
        sessionStorage.setItem('scrollPos', window.scrollY.toString())
      })

      window.addEventListener('load', () => {
        const savedPos = sessionStorage.getItem('scrollPos')

        if (savedPos) {
          const images = document.querySelectorAll('img')

          const imagePromises = Array.from(images).map((img) => {
            if (img.complete) {
              return Promise.resolve()
            }

            return new Promise((resolve) => {
              img.onload = resolve
              img.onerror = resolve
            })
          })

          Promise.all(imagePromises).then(() => {
            window.scrollTo(0, Number.parseInt(savedPos))
            sessionStorage.removeItem('scrollPos')
            document.body.classList.add('loaded')
          })
        }
        else {
          document.body.classList.add('loaded')
        }

        document.documentElement.classList.add('transition-ready')
      })

      document.addEventListener('astro:before-swap', (e) => {
        const saved = localStorage.getItem('vueuse-color-scheme')
        const isDark = saved === 'dark'

        const newDoc = e.newDocument.documentElement

        if (isDark) {
          newDoc.classList.add('dark')
          newDoc.style.colorScheme = 'dark'
        }
        else {
          newDoc.classList.remove('dark')
          newDoc.style.colorScheme = 'light'
        }

        newDoc.classList.add('transition-ready')
      })

      document.addEventListener('astro:page-load', () => {
        const saved = localStorage.getItem('vueuse-color-scheme')
        const isDark = saved === 'dark'

        if (isDark) {
          document.documentElement.classList.add('dark')
        }
        else {
          document.documentElement.classList.remove('dark')
        }

        document.documentElement.classList.add('transition-ready')
        document.body.classList.add('loaded')

        document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
          anchor.addEventListener('click', function (e) {
            e.preventDefault()

            const target = document.querySelector(this.getAttribute('href'))

            if (target) {
              target.scrollIntoView({
                behavior: 'smooth',
                block: 'start',
              })
            }
          })
        })
      })
    </script>

    <style>
      .transition-ready * {
        transition-property:
          color,
          background-color,
          border-color,
          fill,
          stroke,
          opacity,
          transform !important;
        transition-duration: 200ms !important;
        transition-timing-function: ease-in-out !important;
      }
    </style>
  </body>
</html>
